# 값은 비워 둔다. 퍼블릭 레포라 실제 값을 커밋하지 않는다.
NEXTAUTH_URL=
NEXTAUTH_SECRET=
DATABASE_URL=
DIRECT_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 쉼표로 구분한 운영진 예약 이메일. 공개 가입으로 admin 권한을 주지 않는다.
ADMIN_EMAILS=

# 비공개 HTML/녹음 저장소
SUPABASE_MEDIA_BUCKET=study-media
# 비밀 키는 .env.local에 설정
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# 리포트 모델은 lib/reports/generate.ts에서 gpt-5.6-sol / medium으로 고정
