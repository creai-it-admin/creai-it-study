{
  "name": "creai-study-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "prisma generate && next build",
    "start": "node scripts/serve.mjs start",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "node --import tsx --test tests/*.test.ts",
    "auth:password-setup": "tsx scripts/password-setup.ts",
    "test:auth:integration": "node --import tsx --test tests/password-auth.integration.ts",
    "auth:admin": "tsx scripts/grant-admin.ts",
    "storage:setup": "tsx scripts/storage-setup.ts",
    "test:session:integration": "node --import tsx --test tests/session-control.integration.ts",
    "test:study:integration": "node --import tsx --test tests/studies.integration.ts",
    "reports:worker": "tsx scripts/report-worker.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.115.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
